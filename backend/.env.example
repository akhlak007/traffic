PORT=5000
DB_USER=SMART_TRAFFIC
DB_PASSWORD=replace-with-local-oracle-password
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE=FREEPDB1
CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
RATE_LIMIT_PER_MINUTE=120

# At least 32 bytes. Generate locally, for example:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-at-least-32-random-bytes

# Unique values, each at least 32 bytes. Never commit real tokens.
ADMIN_API_TOKEN=replace-with-unique-32-byte-token-admin
OFFICER_API_TOKEN=replace-with-unique-32-byte-token-officer
SUPERVISOR_API_TOKEN=replace-with-unique-32-byte-token-supervisor
OWNER_API_TOKEN=replace-with-unique-32-byte-token-owner
DMP_API_TOKEN=replace-with-unique-32-byte-token-dmp

# These IDs match a fresh run of database/02_insert_demo_data.sql.
# Login itself uses "USER".Email + Password_hash, not these IDs.
ADMIN_USER_ID=1
TRAFFIC_OFFICER_USER_ID=7
SUPERVISOR_USER_ID=6
OWNER_USER_ID=17
DMP_OFFICER_USER_ID=12

SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
SSLCOMMERZ_CALLBACK_BASE_URL=
